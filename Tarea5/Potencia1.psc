Algoritmo Potencia1
	Escribir"Programa para mostrar tabla de potencias desde el 2 hasta el 10 a la decima potencia "
	Definir menores, Potencia, Num Como Real
	Definir i Como Entero
    Escribir "ingrese su nombre " 
	Leer n
	Para i <- 1 Hasta 10 Hacer
			Potencia <- 0
			mayores <- Potencia +i
			mayores <- mayores * mayores * mayores * mayores * mayores * mayores * mayores * mayores * mayores * mayores 
			Escribir n, " La potencia de : ",i " es: ", mayores
			Escribir " "
	FinPara
FinAlgoritmo
