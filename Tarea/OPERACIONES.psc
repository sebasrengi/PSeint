Algoritmo OPERACIONES
	Definir b Como Entero
	Definir c Como Real
	a<-0;
	b<-0;
	c<-0;
	Escribir("introduce el primer numero");
	Leer a;
	Escribir("introduce el segundo numero");
	Leer b;
	c <- a+b;
	Escribir ("La suma es: "),c;
	c <- a-b;
	Escribir ("La resta es: "),c;
	c <- a/b;
	Escribir ("La division es: "),c;
	
FinAlgoritmo