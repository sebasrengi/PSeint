Algoritmo Triangulo
	Definir b Como Entero
	Definir a Como Entero
	Definir d Como Entero
	Definir n Como Entero
	Definir f Como Real
	Definir c Como Real
	a<-0;
	b<-0;
	c<-0;
	d<-0;
	f<-0;
	n<-0;
	Escribir("introduce La base, el primer lado del triangulo");
	Leer a;
	Escribir("introduce el segundo numero del lado del triangulo");
	Leer b;
	Escribir("introduce el tercer numero del lado del triangulo");
	Leer d;
	Escribir("introduce la altura del triangulo");
	Leer n;
	c <- a+b+d;
	Escribir ("El perimetro es: "),c;
	f <- n*a;
	c <- f/2;
	Escribir ("El area es: "),c;
FinAlgoritmo